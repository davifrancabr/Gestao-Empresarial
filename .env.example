# PostgreSQL via Docker Compose (mapeado para 5433 no host)
POSTGRES_DB=gestao
POSTGRES_USER=gestao
POSTGRES_PASSWORD=gestao
POSTGRES_PORT=5433

# Backend (exporte no terminal ou configure na IDE)
DB_URL=jdbc:postgresql://localhost:5433/gestao
DB_USERNAME=gestao
DB_PASSWORD=gestao
DB_POOL_SIZE=10
APP_PORT=8080
APP_SESSION_TIMEOUT=8h
APP_CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
APP_COOKIE_SECURE=false
APP_SEED_DEMO=true
APP_SEED_PASSWORD=gestao123

# Banco usado pelos testes de integração (opcional se o Docker/Testcontainers funcionar)
GESTAO_TEST_DB_URL=jdbc:postgresql://localhost:5433/gestao_test
